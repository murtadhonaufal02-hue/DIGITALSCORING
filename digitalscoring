    <!-- FIREBASE MODULE -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
        import { getDatabase, ref, set, onValue, update } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-database.js";

        const firebaseConfig = {
            apiKey: "AIzaSyB1MgK3pd8d_rSuybwNYF1Xpi_ASy4TzgE",
            authDomain: "digital-scoring-f5181.firebaseapp.com",
            projectId: "digital-scoring-f5181",
            storageBucket: "digital-scoring-f5181.firebasestorage.app",
            messagingSenderId: "824919823278",
            appId: "1:824919823278:web:5e70122dbf2c4dddf06e3f"
        };

        const app = initializeApp(firebaseConfig);
        const db = getDatabase(app);
        const stateRef = ref(db, 'pencak_state');

        const INITIAL_STATE = {
            event: "Pencak Silat", timer: 120, babak: 1, isRunning: false,
            matches: Array.from({length: 1000}, (_, i) => ({ 
                p: i+1, m: "", b: "", km: "", kb: "", cat: "USIA DINI", kelas: "A", 
                gender: "PUTRA", fase: "PENYISIHAN", rounds: 3, duration: 120, winner: null 
            })),
            idx: 0,
            merah: { juri: {j1:[0,0,0], j2:[0,0,0], j3:[0,0,0]}, penHistory: [], jat: 0, dis: false, history: {j1:[], j2:[], j3:[]} },
            biru: { juri: {j1:[0,0,0], j2:[0,0,0], j3:[0,0,0]}, penHistory: [], jat: 0, dis: false, history: {j1:[], j2:[], j3:[]} },
            var: { active: false, type: "", res: {} }, juriNames: { j1: "---", j2: "---", j3: "---" }
        };

        let state = INITIAL_STATE;
        let localJuri = 0, tInt, sekrePage = 0;

        // Firebase Sync Logic
        onValue(stateRef, (snapshot) => {
            const data = snapshot.val();
            if (data) {
                // Perbaikan Timer: Jika lokal sedang running dan device ini adalah dewan, jangan overwrite timer lokal dengan yang lama dari DB
                // Namun untuk sinkronisasi monitor, kita pakai state dari DB.
                const wasRunning = state.isRunning;
                state = data;
                updateUI();
            } else {
                set(stateRef, INITIAL_STATE);
            }
        });

        // Global functions exposed to window for onclick handlers
        window.broadcast = () => set(stateRef, state);
        
        window.changeScreen = (id) => {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active')); 
            document.getElementById('screen-'+id).classList.add('active'); 
            if(id === 'sekretaris') renderSekretarisInputs(); 
            if(id === 'skema') populateSkemaFilters();
        };

        window.slideSekre = (dir) => { 
            sekrePage = Math.max(0, Math.min(99, sekrePage + dir)); 
            renderSekretarisInputs(); 
        };

        function renderSekretarisInputs() {
            const start = sekrePage * 10; const end = start + 10;
            document.getElementById('sekre-range').innerText = `${start + 1} - ${end}`;
            const cont = document.getElementById('sekre-inputs-container'); cont.innerHTML = "";
            for(let i = start; i < end; i++) {
                const m = state.matches[i];
                cont.innerHTML += `
                <div class="p-3 border rounded-xl bg-slate-50 relative">
                    <div class="absolute -top-2 -left-2 bg-purple-600 text-white text-[8px] px-2 py-1 rounded-lg font-bold">P-${m.p}</div>
                    <div class="grid grid-cols-4 gap-1 mt-2">
                        <select id="in-cat-${i}" class="border p-1 rounded-lg text-[7px] font-bold">
                            <option value="USIA DINI" ${m.cat==='USIA DINI'?'selected':''}>DINI</option>
                            <option value="PRA REMAJA" ${m.cat==='PRA REMAJA'?'selected':''}>PRA REMAJA</option>
                            <option value="REMAJA" ${m.cat==='REMAJA'?'selected':''}>REMAJA</option>
                            <option value="DEWASA" ${m.cat==='DEWASA'?'selected':''}>DEWASA</option>
                        </select>
                        <input id="in-kls-${i}" type="text" value="${m.kelas}" class="border p-1 rounded-lg text-[7px] font-bold uppercase text-center">
                        <select id="in-gen-${i}" class="border p-1 rounded-lg text-[7px] font-bold">
                            <option value="PUTRA" ${m.gender==='PUTRA'?'selected':''}>PUTRA</option>
                            <option value="PUTRI" ${m.gender==='PUTRI'?'selected':''}>PUTRI</option>
                        </select>
                        <select id="in-fas-${i}" class="border p-1 rounded-lg text-[7px] font-bold">
                            <option value="PENYISIHAN" ${m.fase==='PENYISIHAN'?'selected':''}>PENYISIHAN</option>
                            <option value="PEREMPAT FINAL" ${m.fase==='PEREMPAT FINAL'?'selected':''}>PEREMPAT FINAL</option>
                            <option value="SEMI FINAL" ${m.fase==='SEMI FINAL'?'selected':''}>SEMI FINAL</option>
                            <option value="FINAL" ${m.fase==='FINAL'?'selected':''}>FINAL</option>
                        </select>
                    </div>
                    <div class="grid grid-cols-2 gap-2 mt-2">
                        <div class="p-2 bg-red-50 border border-red-200 rounded-xl space-y-1">
                            <input id="in-m-n-${i}" list="atlet-list" type="text" value="${m.m}" placeholder="NAMA MERAH" class="w-full bg-transparent text-[8px] font-black uppercase outline-none">
                            <input id="in-m-k-${i}" type="text" value="${m.km}" placeholder="KONTINGEN" class="w-full bg-transparent text-[7px] font-bold uppercase outline-none">
                        </div>
                        <div class="p-2 bg-blue-50 border border-blue-200 rounded-xl space-y-1">
                            <input id="in-b-n-${i}" list="atlet-list" type="text" value="${m.b}" placeholder="NAMA BIRU" class="w-full bg-transparent text-[8px] font-black uppercase outline-none">
                            <input id="in-b-k-${i}" type="text" value="${m.kb}" placeholder="KONTINGEN" class="w-full bg-transparent text-[7px] font-bold uppercase outline-none">
                        </div>
                    </div>
                </div>`;
            }
            renderBaganTable();
        }

        window.saveSekreData = () => {
            const start = sekrePage * 10; const end = start + 10; 
            for(let i = start; i < end; i++) { 
                state.matches[i] = { 
                    ...state.matches[i],
                    p: i + 1, 
                    cat: document.getElementById(`in-cat-${i}`).value, 
                    kelas: document.getElementById(`in-kls-${i}`).value, 
                    gender: document.getElementById(`in-gen-${i}`).value, 
                    fase: document.getElementById(`in-fas-${i}`).value, 
                    m: document.getElementById(`in-m-n-${i}`).value, 
                    km: document.getElementById(`in-m-k-${i}`).value, 
                    b: document.getElementById(`in-b-n-${i}`).value, 
                    kb: document.getElementById(`in-b-k-${i}`).value
                }; 
            } 
            const ani = document.getElementById('save-ani'); ani.classList.add('show'); setTimeout(() => ani.classList.remove('show'), 2000); 
            window.broadcast(); 
        };

        function renderBaganTable() { 
            const tbody = document.getElementById('bagan-table-body'); tbody.innerHTML = ""; 
            state.matches.forEach((m, idx) => { 
                if(m.m !== "" || m.b !== "") { 
                    tbody.innerHTML += `<tr class="border-b"><td class="p-2 font-bold">${m.p}</td><td class="p-2"><div class="text-red-600 font-bold">${m.m} (${m.km})</div><div class="text-blue-600 font-bold">${m.b} (${m.kb})</div></td><td class="p-2 text-[7px] font-bold">${m.kelas} ${m.cat}</td><td class="p-2 text-center">---</td><td class="p-2 text-center"><button onclick="editMatch(${idx})" class="text-blue-500 mr-2"><i class="fas fa-edit"></i></button><button onclick="deleteMatch(${idx})" class="text-red-500"><i class="fas fa-trash"></i></button></td></tr>`; 
                } 
            }); 
        }

        window.editMatch = (i) => { sekrePage = Math.floor(i / 10); renderSekretarisInputs(); };
        window.deleteMatch = (i) => { if(confirm("Hapus?")) { state.matches[i] = INITIAL_STATE.matches[i]; window.broadcast(); } };

        window.populateSkemaFilters = () => {
            const kFilter = document.getElementById('skema-kelas-filter');
            kFilter.innerHTML = '<option value="">PILIH KELAS</option>';
            const uniqueClasses = [...new Set(state.matches.filter(m => m.m || m.b).map(m => `${m.cat} ${m.gender} KELAS ${m.kelas}`))];
            uniqueClasses.sort().forEach(q => kFilter.innerHTML += `<option value="${q}">${q}</option>`);
            window.renderSkema();
        };

        window.renderSkema = () => {
            const container = document.getElementById('bracket-view');
            const classFilter = document.getElementById('skema-kelas-filter').value;
            const faseFilter = document.getElementById('skema-fase-filter').value;
            container.innerHTML = "";
            if(!classFilter) { container.innerHTML = "<p class='m-auto opacity-30'>PILIH KELAS</p>"; return; }

            const phases = ["PENYISIHAN", "PEREMPAT FINAL", "SEMI FINAL", "FINAL"];
            const displayPhases = faseFilter === "ALL" ? phases : [faseFilter];

            displayPhases.forEach(phase => {
                const matches = state.matches.filter(m => (m.m || m.b) && (`${m.cat} ${m.gender} KELAS ${m.kelas}` === classFilter) && (m.fase === phase));
                if(matches.length > 0) {
                    const column = document.createElement('div');
                    column.className = "bracket-column";
                    column.innerHTML = `<h3 class="text-center font-black text-[10px] bg-slate-900 text-white py-2 rounded-xl mb-4 italic">${phase}</h3>`;
                    matches.forEach(m => {
                        const box = document.createElement('div');
                        box.className = `match-box ${state.idx + 1 === m.p ? 'active-match' : ''}`;
                        box.innerHTML = `<div class="match-atlet sudut-merah-bg"><span class="atlet-name">${m.m || '?'}</span></div><div class="match-atlet sudut-biru-bg"><span class="atlet-name">${m.b || '?'}</span></div>`;
                        column.appendChild(box);
                    });
                    container.appendChild(column);
                }
            });
        };

        window.timerCtrl = (cmd) => {
            if(cmd === 'start') {
                if(!state.isRunning) {
                    state.isRunning = true;
                    // Dewan yang menjalankan timer akan melakukan update periodik ke DB
                    tInt = setInterval(() => {
                        if(state.timer > 0) {
                            state.timer--;
                            // Update timer path khusus agar tidak mengganggu penulisan juri
                            update(ref(db, 'pencak_state'), { timer: state.timer });
                        } else {
                            window.timerCtrl('stop');
                        }
                    }, 1000);
                    window.broadcast();
                }
            } else if(cmd === 'stop') {
                state.isRunning = false;
                clearInterval(tInt);
                window.broadcast();
            } else if(cmd === 'reset') {
                state.timer = state.matches[state.idx].duration || 120;
                state.isRunning = false;
                clearInterval(tInt);
                window.broadcast();
            }
        };

        window.setRound = (n) => { state.babak = n; state.timer = state.matches[state.idx].duration || 120; state.isRunning = false; clearInterval(tInt); window.broadcast(); };
        window.selectMatchPrompt = () => { let p = prompt("Partai:"); if(p) { state.idx = parseInt(p)-1; state.timer = state.matches[state.idx].duration; window.broadcast(); } };
        window.openSelesaiModal = () => { document.getElementById('modal-confirm').style.display = 'flex'; };
        window.confirmSelesai = (ans) => {
            if(ans) {
                const tm = calculateTotal('merah'), tb = calculateTotal('biru'), m = state.matches[state.idx];
                const wSudut = tm > tb ? 'MERAH' : tb > tm ? 'BIRU' : 'DRAW';
                document.getElementById('win-nama').innerText = wSudut === 'MERAH' ? m.m : m.b;
                document.getElementById('winner-notif').style.display = 'flex';
            }
            document.getElementById('modal-confirm').style.display = 'none';
        };
        window.closeWinnerNotif = () => { document.getElementById('winner-notif').style.display = 'none'; state.merah = INITIAL_STATE.merah; state.biru = INITIAL_STATE.biru; window.broadcast(); };
        window.nextMatchConfirm = () => { state.idx++; state.timer = state.matches[state.idx].duration; window.broadcast(); };

        window.applyPenalty = (s, p) => {
            const idx = state[s].penHistory.findIndex(x => x.type === p && x.round === state.babak);
            if(idx > -1) state[s].penHistory.splice(idx, 1);
            else state[s].penHistory.push({ type: p, round: state.babak });
            window.broadcast();
        };

        window.addJatuhan = (s) => { state[s].jat += 3; window.broadcast(); };
        window.setDis = (s) => { state[s].dis = true; window.broadcast(); };
        window.initJuri = (n) => { localJuri = n; document.getElementById('modal-jr-partai').innerText = state.matches[state.idx].p; document.getElementById('modal-juri-identity').style.display = 'flex'; };
        window.submitJuriIdentity = () => { state.juriNames['j'+localJuri] = document.getElementById('input-juri-name-modal').value; document.getElementById('modal-juri-identity').style.display = 'none'; window.changeScreen('juri'); window.broadcast(); };

        window.sendHitDirect = (sudut, val) => {
            if(!state.isRunning) return;
            document.getElementById('snd-hit').play();
            // Fetch state terbaru sebelum update juri untuk mencegah desync timer
            onValue(stateRef, (snap) => {
                const cur = snap.val();
                state[sudut].juri['j'+localJuri][state.babak-1] += val;
                state[sudut].history['j'+localJuri].push(val);
                // Update specific path juri saja agar timer tetap berjalan lancar
                const updates = {};
                updates[`/merah/juri`] = state.merah.juri;
                updates[`/biru/juri`] = state.biru.juri;
                updates[`/merah/history`] = state.merah.history;
                updates[`/biru/history`] = state.biru.history;
                update(stateRef, updates);
            }, { onlyOnce: true });
        };

        window.initiateVar = (type) => { state.var = { active: true, type: type, res: {} }; window.broadcast(); document.getElementById('modal-var-setup').style.display = 'none'; };
        window.voteVar = (v) => { state.var.res['j'+localJuri] = v; window.broadcast(); };
        window.closeVar = () => { state.var.active = false; window.broadcast(); };

        function calculateTotal(s) {
            const sc = state[s];
            if(sc.dis) return "DSQ";
            const tj = sc.juri.j1.reduce((a,b)=>a+b,0) + sc.juri.j2.reduce((a,b)=>a+b,0) + sc.juri.j3.reduce((a,b)=>a+b,0);
            const map = { teguran1: 1, teguran2: 2, peringatan1: 5, peringatan2: 10 };
            let tp = 0; sc.penHistory.forEach(x => tp += (map[x.type] || 0));
            return tj + sc.jat - tp;
        }

        function updateUI() {
            const m = state.matches[state.idx];
            const tStr = (s) => { const min = Math.floor(s/60); const sec = s % 60; return `${min.toString().padStart(2,'0')}:${sec.toString().padStart(2,'0')}`; };
            
            document.querySelectorAll('[id$="-timer-disp"], #mon-timer').forEach(el => el.innerText = tStr(state.timer));
            document.querySelectorAll('[id$="-babak-disp"], #mon-babak').forEach(el => el.innerText = "BABAK " + state.babak);
            
            const tm = calculateTotal('merah'), tb = calculateTotal('biru');
            document.getElementById('dw-total-m').innerText = tm; document.getElementById('dw-total-b').innerText = tb;
            if(document.getElementById('mon-total-m')) {
                document.getElementById('mon-total-m').innerText = tm;
                document.getElementById('mon-total-b').innerText = tb;
            }

            document.getElementById('dw-m-nama').innerText = m.m || "MERAH";
            document.getElementById('dw-b-nama').innerText = m.b || "BIRU";
            
            if(localJuri) {
                document.getElementById('jr-role-name').innerText = state.juriNames['j'+localJuri] + " (JURI " + localJuri + ")";
                document.getElementById('jr-match-no').innerText = m.p;
                document.getElementById('jr-m-nama-full').innerText = m.m; document.getElementById('jr-b-nama-full').innerText = m.b;
                document.getElementById('jr-history-m').innerText = state.merah.history['j'+localJuri].join(", ");
                document.getElementById('jr-history-b').innerText = state.biru.history['j'+localJuri].join(", ");
            }

            // Real-time Table
            const renderTable = (id) => {
                const el = document.getElementById(id); if(!el) return;
                el.innerHTML = `
                    <tr class="sudut-merah-bg"><td class="text-left px-2 font-bold">${m.m || 'MERAH'}</td><td>${state.merah.juri.j1[0]}</td><td>${state.merah.juri.j1[1]}</td><td>${state.merah.juri.j1[2]}</td><td>${state.merah.juri.j2[0]}</td><td>${state.merah.juri.j2[1]}</td><td>${state.merah.juri.j2[2]}</td><td>${state.merah.juri.j3[0]}</td><td>${state.merah.juri.j3[1]}</td><td>${state.merah.juri.j3[2]}</td><td class="bg-white text-red-600 font-black">${tm}</td></tr>
                    <tr class="sudut-biru-bg"><td class="text-left px-2 font-bold">${m.b || 'BIRU'}</td><td>${state.biru.juri.j1[0]}</td><td>${state.biru.juri.j1[1]}</td><td>${state.biru.juri.j1[2]}</td><td>${state.biru.juri.j2[0]}</td><td>${state.biru.juri.j2[1]}</td><td>${state.biru.juri.j2[2]}</td><td>${state.biru.juri.j3[0]}</td><td>${state.biru.juri.j3[1]}</td><td>${state.biru.juri.j3[2]}</td><td class="bg-white text-blue-600 font-black">${tb}</td></tr>`;
            };
            renderTable('dw-rt-table'); renderTable('mon-rt-table');

            // Penalty Highlighting
            ['merah','biru'].forEach(s => {
                const prefix = s === 'merah' ? 'm-' : 'b-';
                ['b1','b2','t1','t2','p1','p2'].forEach(k => {
                    const el = document.getElementById(prefix+k);
                    if(el) {
                        const typeMap = {b1:'binaan1',b2:'binaan2',t1:'teguran1',t2:'teguran2',p1:'peringatan1',p2:'peringatan2'};
                        const active = state[s].penHistory.some(x => x.type === typeMap[k] && x.round === state.babak);
                        active ? el.classList.add('active-feature') : el.classList.remove('active-feature');
                    }
                });
            });

            // VAR Overlay
            if(state.var.active) {
                if(localJuri) {
                    document.getElementById('var-overlay').style.display = 'flex';
                } else {
                    document.getElementById('dw-var-popup').style.display = 'flex';
                    let circles = "";
                    ['j1','j2','j3'].forEach(j => {
                        const r = state.var.res[j];
                        const col = r==='MERAH' ? 'bg-red-600' : r==='BIRU' ? 'bg-blue-600' : r==='TIDAK SAH' ? 'bg-yellow-500' : 'bg-gray-400';
                        circles += `<div class="var-circle ${col}">${j[1]}</div>`;
                    });
                    document.getElementById('dw-var-circles').innerHTML = circles;
                }
            } else {
                document.getElementById('var-overlay').style.display = 'none';
                document.getElementById('dw-var-popup').style.display = 'none';
            }
        }

        window.resetData = () => { if(confirm("Reset seluruh data ke awal?")) set(stateRef, INITIAL_STATE); };

        setInterval(() => {
            const now = new Date();
            if(document.getElementById('mon-realtime-clock')) {
                document.getElementById('mon-realtime-date').innerText = now.toLocaleDateString();
                document.getElementById('mon-realtime-clock').innerText = now.toLocaleTimeString();
            }
        }, 1000);

    </script>
</body>
</html>
